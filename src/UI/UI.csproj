<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Final binary name: BACAP_Addon_Helper.exe -->
        <AssemblyName>WB_Addon_Helper</AssemblyName>
        <RootNamespace>UI</RootNamespace>

        <!-- Application metadata -->
        <Product>WB Addon Helper</Product>
        <Authors>ItzSkyReed</Authors>
        <Description>Interactive CLI tool for managing and generating WB Addon for BACAP(ED).</Description>

        <!-- Code quality & analyzers -->
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <!-- Suppress CA1707 (assembly name contains underscores) -->
        <NoWarn>$(NoWarn);CA1707</NoWarn>



        <InvariantGlobalization>false</InvariantGlobalization>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>none</DebugType>
        <DebuggerSupport>false</DebuggerSupport>
        <DebugSymbols>false</DebugSymbols>
        <!-- Strips native debug symbols on Linux and macOS -->
        <StripSymbols>true</StripSymbols>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="default_wb_config.yaml" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BacapGenerator\BacapGenerator.csproj" />
        <ProjectReference Include="..\WbGenerator\WbGenerator.csproj" />
    </ItemGroup>



    <ItemGroup>
        <PackageReference Include="dotenv.net" Version="4.2.0" />
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
        <PackageReference Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />
        <PackageReference Include="Spectre.Console" Version="0.57.2" />
    </ItemGroup>

</Project>