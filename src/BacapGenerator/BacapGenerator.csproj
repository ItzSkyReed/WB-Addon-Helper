<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- NuGet Package Metadata -->
        <PackageId>BACAP-Addon-Helper.BacapGenerator</PackageId>
        <Authors>ItzSkyReed</Authors>
        <Description>Core functionality to work with BACAP Addon Helper</Description>
        <RepositoryUrl>https://github.com/ItzSkyReed/BACAP-Addon-Helper</RepositoryUrl>
        <PackageLicenseExpression>CC-BY-NC-SA-4.0</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <!-- Обычная проектная ссылка: локально работает как проект, а dotnet pack сам сделает из неё зависимость пакета -->
        <ProjectReference Include="..\Core\Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
        <PackageReference Include="YamlDotNet" Version="18.1.0" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Io\" />
    </ItemGroup>

</Project>